# 漫畫來源資料夾（更換磁碟機時只需修改這裡，然後重新掃描）
COMICS_ROOT=G:\Comics

# SumatraPDF 執行檔路徑（留空則自動尋找常見安裝位置）
SUMATRA_PATH=

# 7-Zip 路徑（用於擷取 RAR / 7Z 封面，留空則自動尋找）
SEVENZIP_PATH=

# 網頁伺服器埠號（僅綁定本機 127.0.0.1）
PORT=8085

# 分類：資料夾名稱:顯示名稱（依此順序顯示）
CATEGORY_MAP=HK:香港,Japan:日本,TW:台灣,US:美國

# 納入管理的副檔名
FILE_TYPES=pdf,epub,zip,cbz,rar,cbr,7z,mobi

# 啟動時是否自動增量掃描
SCAN_ON_STARTUP=true

# 加密壓縮檔的解壓密碼（以逗號分隔，只用來擷取封面）
ARCHIVE_PASSWORDS=qwer
